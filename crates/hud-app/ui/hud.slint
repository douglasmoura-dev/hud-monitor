import { Bar, Field, Limit, PresenceData, Theme } from "theme.slint";
import { CutBox } from "chrome.slint";
import { MiniBar } from "minibar.slint";
import { CleanRow, Scanner } from "scanner.slint";

export { CleanRow, MiniBar, Scanner, Theme }

component Label inherits Text {
    color: Theme.dim;
    font-family: Theme.label-font;
    font-weight: 600;
    font-size: Theme.lf(11px * Theme.scale);
    letter-spacing: Theme.scaled-tracking;
}

component Val inherits Rectangle {
    in property <Field> field;
    in property <length> size: 13px * Theme.scale;
    in property <color> tint: Theme.text;
    callback tip(string);
    width: t.preferred-width;
    height: t.preferred-height;
    t := Text {
        text: root.field.text;
        color: root.field.tip == "" ? Theme.tone(root.field.level, root.tint) : Theme.dim;
        font-family: Theme.number-font;
        font-size: Theme.nf(root.size);
    }
    TouchArea {
        enabled: root.field.tip != "";
        changed has-hover => { root.tip(self.has-hover ? root.field.tip : ""); }
    }
}

// Progress bar drawn by the theme: thin or rounded track, segmented blocks, ASCII text, or nothing.
component Meter inherits Rectangle {
    in property <float> percent;
    in property <color> tint;
    in property <int> cells: 20;
    in property <int> ascii-cells: 24;
    height: Theme.bar-style == "rounded" ? 8px * Theme.scale : 6px * Theme.scale;
    visible: Theme.bar-style != "none";
    private property <length> gap: 2px * Theme.scale;
    private property <length> block: (root.width - root.gap * (root.cells - 1)) / root.cells;
    if Theme.bar-style == "thin" || Theme.bar-style == "rounded" : Rectangle {
        border-radius: root.height / 2;
        background: Theme.track;
        Rectangle {
            x: 0px;
            width: parent.width * clamp(root.percent, 0, 100) / 100;
            border-radius: parent.border-radius;
            background: root.tint;
        }
    }
    if Theme.bar-style == "segmented" : Rectangle {
        for i in root.cells : Rectangle {
            x: i * (root.block + root.gap);
            width: root.block;
            background: i < Theme.lit(root.percent, root.cells) ? root.tint : Theme.track;
        }
    }
    if Theme.bar-style == "ascii" : Text {
        y: (root.height - self.height) / 2;
        width: parent.width;
        height: 14px * Theme.scale;
        text: Theme.ascii(root.percent, root.ascii-cells);
        color: root.tint;
        font-family: Theme.number-font;
        font-size: Theme.nf(11px * Theme.scale);
        vertical-alignment: center;
        overflow: clip;
    }
}

component Rule inherits Rectangle {
    height: 1px;
    background: Theme.track;
    visible: !Theme.airy && !Theme.cards;
}

// Status dot of the card layout, colored by alert level.
component Dot inherits Rectangle {
    in property <int> level;
    visible: Theme.cards;
    width: 8px * Theme.scale;
    height: 8px * Theme.scale;
    border-radius: 4px * Theme.scale;
    background: Theme.tone(root.level, Theme.green);
}

component Card inherits Rectangle {
    visible: Theme.cards;
    x: 6px * Theme.scale;
    border-radius: 8px * Theme.scale;
    background: Theme.card;
    border-width: 1px;
    border-color: Theme.track;
}

component Arrow inherits Path {
    in property <bool> down;
    width: 8px * Theme.scale;
    height: 7px * Theme.scale;
    viewbox-width: 8;
    viewbox-height: 7;
    commands: root.down ? "M 0 0 L 8 0 L 4 7 Z" : "M 0 7 L 8 7 L 4 0 Z";
}

component LimitRow inherits Rectangle {
    in property <string> name;
    in property <Limit> limit;
    in property <color> tint;
    callback tip(string);
    height: 18px * Theme.scale;
    Text {
        x: 0px;
        width: 52px * Theme.scale;
        text: Theme.lb(root.name);
        color: Theme.dim;
        font-family: Theme.label-font;
        font-weight: 600;
        font-size: Theme.lf(11px * Theme.scale);
        letter-spacing: Theme.scaled-tracking;
        vertical-alignment: center;
    }
    Meter { x: 56px * Theme.scale; y: 6px * Theme.scale; width: 100px * Theme.scale; cells: 10; ascii-cells: 11; percent: root.limit.percent; tint: root.tint; }
    Val { x: Theme.bar-style == "none" ? 56px * Theme.scale : 164px * Theme.scale; y: 1px; size: 12px * Theme.scale; field: root.limit.pct; tip(s) => { root.tip(s); } }
    Text {
        x: parent.width - self.width;
        width: 48px * Theme.scale;
        text: root.limit.reset;
        color: Theme.dim;
        font-family: Theme.number-font;
        font-size: Theme.nf(11px * Theme.scale);
        vertical-alignment: center;
        horizontal-alignment: right;
    }
}

component PresenceRow inherits Rectangle {
    in property <string> name;
    in property <string> status;
    Text {
        x: 0px;
        y: 0px;
        width: 90px * Theme.scale;
        height: parent.height;
        text: root.name;
        color: Theme.dim;
        font-family: Theme.label-font;
        font-weight: 600;
        font-size: Theme.lf(11px * Theme.scale);
        letter-spacing: Theme.scaled-tracking;
        vertical-alignment: center;
        horizontal-alignment: left;
    }
    Text {
        x: 100px * Theme.scale;
        y: 0px;
        width: parent.width - 100px * Theme.scale;
        height: parent.height;
        text: root.status;
        color: root.status == "inativo" ? Theme.dim : Theme.teal;
        font-family: Theme.number-font;
        font-size: Theme.nf(12px * Theme.scale);
        vertical-alignment: center;
        horizontal-alignment: left;
    }
}

component GpuCell inherits Rectangle {
    in property <string> name;
    in property <Field> field;
    callback tip(string);
    width: 96px * Theme.scale;
    height: 32px * Theme.scale;
    Label { x: 0px; y: 0px; text: Theme.lb(root.name); }
    Val { x: 0px; y: 14px * Theme.scale; field: root.field; tip(s) => { root.tip(s); } }
}

export component Hud inherits Window {
    no-frame: true;
    always-on-top: true;
    background: transparent;
    width: 320px * Theme.scale;
    private property <length> gemini-y: 478px * Theme.scale + (root.codex-listed ? 66px * Theme.scale : 0px);
    private property <length> cursor-y: root.gemini-y + (root.gemini-listed ? 44px * Theme.scale : 0px);
    private property <length> others-y: root.cursor-y + (root.cursor-listed ? 44px * Theme.scale : 0px);
    private property <length> others-h: root.presence.length > 0 ? 18px * Theme.scale + 20px * Theme.scale * root.presence.length : 0px;
    height: root.others-y + root.others-h + 22px * Theme.scale;
    callback moved(length, length);
    callback released();
    callback resize(length, length, length, length);
    callback resize-done();
    callback quit();
    callback minimize();
    callback pin();
    in property <bool> pinned;
    in property <string> pin-tip;
    in property <string> notice;
    in property <float> bg-alpha: 0.88;
    in property <string> clock: "--:--";
    in property <Field> cpu-total;
    in property <Field> cpu-freq;
    in property <Field> cpu-temp;
    in property <Field> cpu-cores;
    in property <[Bar]> core-bars;
    in property <Field> ram;
    in property <float> ram-percent;
    in property <Field> ram-top;
    in property <Field> gpu-intel;
    in property <Field> gpu-nvidia;
    in property <Field> gpu-vram;
    in property <Field> disk;
    in property <float> disk-percent;
    in property <Field> disk-io;
    in property <Field> net-down;
    in property <Field> net-up;
    in property <Field> net-today;
    in property <Field> ping;
    in property <string> claude-plan;
    in property <Limit> claude-5h;
    in property <Limit> claude-7d;
    in property <bool> codex-listed;
    in property <Limit> codex-5h;
    in property <Limit> codex-7d;
    in property <bool> gemini-listed;
    in property <Limit> gemini-day;
    in property <bool> cursor-listed;
    in property <Limit> cursor-month;
    in property <[PresenceData]> presence;
    property <string> hover-tip;
    private property <bool> blink-on: true;
    private property <length> title-x: Theme.prompt ? 10px * Theme.scale : 26px * Theme.scale;

    Rectangle {
        background: Theme.scaled-cut > 0px ? transparent : Theme.background.with-alpha(root.bg-alpha);
        border-color: Theme.border;
        border-width: Theme.borders && Theme.scaled-cut == 0px ? 1px : 0px;
        border-radius: Theme.scaled-radius;
        clip: true;

        if Theme.scaled-cut > 0px : CutBox {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            cut: Theme.scaled-cut;
            fill: Theme.background.with-alpha(root.bg-alpha);
            line: Theme.borders ? Theme.border : transparent;
        }

        // Title strip
        if Theme.scaled-cut == 0px : Rectangle {
            y: 0px;
            height: 30px * Theme.scale;
            background: Theme.title-bar;
        }
        if Theme.scaled-cut > 0px : CutBox {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: 30px * Theme.scale;
            cut: Theme.scaled-cut;
            top-only: true;
            fill: Theme.title-bar;
        }
        Rectangle {
            y: 0px;
            height: 30px * Theme.scale;
            TouchArea {
                moved => { root.moved(self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y); }
                pointer-event(e) => { if e.kind == PointerEventKind.up { root.released(); } }
            }
            if !Theme.prompt : Rectangle {
                x: 0px;
                for row in [0, 1, 2]: Rectangle {
                    x: 10px * Theme.scale;
                    y: 9px * Theme.scale + row * 5px * Theme.scale;
                    width: 8px * Theme.scale;
                    height: 2px * Theme.scale;
                    background: Theme.title-icon;
                }
            }
            title := Text {
                x: root.title-x;
                text: Theme.title;
                color: Theme.title-text;
                font-family: Theme.title-font;
                font-weight: 600;
                font-size: Theme.lf(14px * Theme.scale);
                letter-spacing: Theme.scaled-tracking;
                vertical-alignment: center;
            }
            if Theme.prompt : Rectangle { // blinking cursor after the prompt
                x: root.title-x + title.preferred-width + 4px * Theme.scale;
                y: 8px * Theme.scale;
                width: 8px * Theme.scale;
                height: 14px * Theme.scale;
                background: Theme.title-text;
                opacity: root.blink-on ? 1 : 0;
            }
            Timer {
                interval: 1s;
                running: Theme.prompt;
                triggered => { root.blink-on = !root.blink-on; }
            }
            Text {
                x: parent.width - 138px * Theme.scale;
                width: 48px * Theme.scale;
                text: root.clock;
                color: Theme.title-icon;
                font-family: Theme.number-font;
                font-size: Theme.nf(12px * Theme.scale);
                vertical-alignment: center;
                horizontal-alignment: right;
            }
            TouchArea { // pin: toggles click-through (hold Ctrl to interact meanwhile)
                x: parent.width - 86px * Theme.scale;
                width: 22px * Theme.scale;
                clicked => { root.pin(); }
                changed has-hover => { root.hover-tip = self.has-hover ? root.pin-tip : ""; }
                Rectangle {
                    x: 6px * Theme.scale;
                    y: 10px * Theme.scale;
                    width: 10px * Theme.scale;
                    height: 10px * Theme.scale;
                    border-radius: 5px * Theme.scale;
                    border-width: 1.5px * Theme.scale;
                    border-color: root.pinned || parent.has-hover ? Theme.title-text : Theme.title-icon;
                    background: root.pinned ? Theme.title-text : transparent;
                }
            }
            TouchArea { // minimize to the mini bar
                x: parent.width - 62px * Theme.scale;
                width: 22px * Theme.scale;
                clicked => { root.minimize(); }
                Rectangle {
                    x: 6px * Theme.scale;
                    y: 10px * Theme.scale;
                    width: 10px * Theme.scale;
                    height: 10px * Theme.scale;
                    border-width: 1.5px * Theme.scale;
                    border-color: Theme.title-icon;
                }
            }
            TouchArea { // close
                x: parent.width - 32px * Theme.scale;
                width: 28px * Theme.scale;
                clicked => { root.quit(); }
                Path {
                    x: 9px * Theme.scale;
                    y: 10px * Theme.scale;
                    width: 10px * Theme.scale;
                    height: 10px * Theme.scale;
                    viewbox-width: 10;
                    viewbox-height: 10;
                    commands: "M 0 0 L 10 10 M 10 0 L 0 10";
                    stroke: Theme.title-icon;
                    stroke-width: 1.5px * Theme.scale;
                }
            }
        }

        if Theme.has-side-rule : Rectangle {
            x: 0px;
            y: Theme.scaled-cut;
            width: 3px * Theme.scale;
            height: parent.height - 2 * Theme.scaled-cut;
            background: Theme.side-rule;
        }

        // Cards of the light theme
        Card { y: 34px * Theme.scale; width: 308px * Theme.scale; height: 106px * Theme.scale; }
        Card { y: 146px * Theme.scale; width: 308px * Theme.scale; height: 52px * Theme.scale; }
        Card { y: 204px * Theme.scale; width: 308px * Theme.scale; height: 56px * Theme.scale; }
        Card { y: 266px * Theme.scale; width: 308px * Theme.scale; height: 52px * Theme.scale; }
        Card { y: 322px * Theme.scale; width: 308px * Theme.scale; height: 62px * Theme.scale; }

        // CPU
        cpu-label := Label { x: 12px * Theme.scale; y: 36px * Theme.scale; text: Theme.lb("CPU"); }
        Dot { x: cpu-label.x + cpu-label.preferred-width + 6px * Theme.scale; y: 40px * Theme.scale; level: root.cpu-total.level; }
        Val { x: 12px * Theme.scale; y: Theme.airy ? 46px * Theme.scale : 48px * Theme.scale; size: Theme.airy ? 44px * Theme.scale : 28px * Theme.scale; tint: Theme.teal; field: root.cpu-total; tip(s) => { root.hover-tip = s; } }
        if !Theme.airy : Rectangle {
            Val { x: 100px * Theme.scale; y: 52px * Theme.scale; field: root.cpu-freq; tip(s) => { root.hover-tip = s; } }
            Val { x: 100px * Theme.scale; y: 70px * Theme.scale; field: root.cpu-temp; tip(s) => { root.hover-tip = s; } }
            Val { x: 12px * Theme.scale; y: 88px * Theme.scale; size: 11px * Theme.scale; tint: Theme.dim; field: root.cpu-cores; tip(s) => { root.hover-tip = s; } }
        }
        if Theme.airy : HorizontalLayout { // one dim line with the CPU details
            x: 12px * Theme.scale;
            y: 104px * Theme.scale;
            height: 16px * Theme.scale;
            spacing: 12px * Theme.scale;
            alignment: start;
            Val { size: 11px * Theme.scale; tint: Theme.dim; field: root.cpu-freq; tip(s) => { root.hover-tip = s; } }
            Val { size: 11px * Theme.scale; tint: Theme.dim; field: root.cpu-temp; tip(s) => { root.hover-tip = s; } }
            Val { size: 11px * Theme.scale; tint: Theme.dim; field: root.cpu-cores; tip(s) => { root.hover-tip = s; } }
        }
        if Theme.bar-style != "none" : Rectangle {
            for bar[i] in root.core-bars: Rectangle {
                x: 12px * Theme.scale + i * 18px * Theme.scale;
                y: 106px * Theme.scale;
                width: 14px * Theme.scale;
                height: 28px * Theme.scale;
                border-radius: Theme.bar-style == "rounded" ? 3px * Theme.scale : 0px;
                background: Theme.track;
                clip: true;
                Rectangle {
                    y: parent.height * (1 - clamp(bar.percent, 0, 100) / 100);
                    height: parent.height - self.y;
                    background: bar.hot ? Theme.crit : Theme.green;
                }
            }
        }
        Rule { x: 12px * Theme.scale; y: 142px * Theme.scale; width: parent.width - 24px * Theme.scale; }

        // RAM
        ram-label := Label { x: 12px * Theme.scale; y: 148px * Theme.scale; text: Theme.lb("RAM"); }
        Dot { x: ram-label.x + ram-label.preferred-width + 6px * Theme.scale; y: 152px * Theme.scale; level: root.ram.level; }
        Val { x: parent.width - 12px * Theme.scale - self.width; y: Theme.airy ? 140px * Theme.scale : 146px * Theme.scale; size: Theme.airy ? 20px * Theme.scale : 13px * Theme.scale; field: root.ram; tip(s) => { root.hover-tip = s; } }
        Meter { x: 12px * Theme.scale; y: 168px * Theme.scale; width: parent.width - 24px * Theme.scale; ascii-cells: 30; percent: root.ram-percent; tint: Theme.purple; }
        Val { x: 12px * Theme.scale; y: 178px * Theme.scale; size: 10px * Theme.scale; tint: Theme.dim; field: root.ram-top; tip(s) => { root.hover-tip = s; } }
        Rule { x: 12px * Theme.scale; y: 200px * Theme.scale; width: parent.width - 24px * Theme.scale; }

        // GPU
        Label { x: 12px * Theme.scale; y: 206px * Theme.scale; text: Theme.lb("GPU"); }
        GpuCell { x: 12px * Theme.scale; y: 222px * Theme.scale; name: "INTEL"; field: root.gpu-intel; tip(s) => { root.hover-tip = s; } }
        GpuCell { x: 112px * Theme.scale; y: 222px * Theme.scale; name: "NVIDIA"; field: root.gpu-nvidia; tip(s) => { root.hover-tip = s; } }
        GpuCell { x: 212px * Theme.scale; y: 222px * Theme.scale; name: "VRAM"; field: root.gpu-vram; tip(s) => { root.hover-tip = s; } }
        Rule { x: 12px * Theme.scale; y: 262px * Theme.scale; width: parent.width - 24px * Theme.scale; }

        // DISCO
        disk-label := Label { x: 12px * Theme.scale; y: 268px * Theme.scale; text: Theme.lb("DISCO"); }
        Dot { x: disk-label.x + disk-label.preferred-width + 6px * Theme.scale; y: 272px * Theme.scale; level: root.disk.level; }
        Val { x: parent.width - 12px * Theme.scale - self.width; y: Theme.airy ? 260px * Theme.scale : 266px * Theme.scale; size: Theme.airy ? 20px * Theme.scale : 13px * Theme.scale; field: root.disk; tip(s) => { root.hover-tip = s; } }
        Meter { x: 12px * Theme.scale; y: 288px * Theme.scale; width: parent.width - 24px * Theme.scale; ascii-cells: 30; percent: root.disk-percent; tint: Theme.amber; }
        Val { x: 12px * Theme.scale; y: 298px * Theme.scale; size: 11px * Theme.scale; tint: Theme.dim; field: root.disk-io; tip(s) => { root.hover-tip = s; } }
        Rule { x: 12px * Theme.scale; y: 318px * Theme.scale; width: parent.width - 24px * Theme.scale; }

        // REDE
        net-label := Label { x: 12px * Theme.scale; y: 324px * Theme.scale; text: Theme.lb("REDE"); }
        Dot { x: net-label.x + net-label.preferred-width + 6px * Theme.scale; y: 328px * Theme.scale; level: root.ping.level; }
        Arrow { x: 12px * Theme.scale; y: 345px * Theme.scale; down: true; fill: Theme.teal; }
        Val { x: 26px * Theme.scale; y: 340px * Theme.scale; tint: Theme.teal; field: root.net-down; tip(s) => { root.hover-tip = s; } }
        Arrow { x: 160px * Theme.scale; y: 345px * Theme.scale; down: false; fill: Theme.blue; }
        Val { x: 174px * Theme.scale; y: 340px * Theme.scale; tint: Theme.blue; field: root.net-up; tip(s) => { root.hover-tip = s; } }
        Val { x: 12px * Theme.scale; y: 362px * Theme.scale; size: 11px * Theme.scale; tint: Theme.dim; field: root.net-today; tip(s) => { root.hover-tip = s; } }
        Val { x: 160px * Theme.scale; y: 362px * Theme.scale; size: 11px * Theme.scale; tint: Theme.dim; field: root.ping; tip(s) => { root.hover-tip = s; } }

        Rule { x: 12px * Theme.scale; y: 384px * Theme.scale; width: parent.width - 24px * Theme.scale; }

        // LIMITES IA
        Label { x: 12px * Theme.scale; y: 390px * Theme.scale; text: Theme.lb("LIMITES IA"); }
        Text {
            x: 12px * Theme.scale;
            y: 408px * Theme.scale;
            text: Theme.lb("CLAUDE");
            color: Theme.text;
            font-family: Theme.label-font;
            font-weight: 600;
            font-size: Theme.lf(13px * Theme.scale);
            letter-spacing: Theme.scaled-tracking;
        }
        Rectangle {
            visible: root.claude-plan != "";
            x: 70px * Theme.scale + (Theme.label-scale - 1) * 40px * Theme.scale;
            y: 409px * Theme.scale;
            width: badge.preferred-width + 10px * Theme.scale;
            height: 15px * Theme.scale;
            border-radius: Theme.scaled-radius > 0px ? 3px * Theme.scale : 0px;
            border-width: 1px;
            border-color: Theme.teal;
            badge := Text {
                x: 5px * Theme.scale;
                text: root.claude-plan;
                color: Theme.teal;
                font-family: Theme.label-font;
                font-weight: 600;
                font-size: Theme.lf(10px * Theme.scale);
                letter-spacing: Theme.scaled-tracking;
                vertical-alignment: center;
            }
        }
        LimitRow { x: 12px * Theme.scale; y: 430px * Theme.scale; width: parent.width - 24px * Theme.scale; name: "5H"; limit: root.claude-5h; tint: Theme.teal; tip(s) => { root.hover-tip = s; } }
        LimitRow { x: 12px * Theme.scale; y: 452px * Theme.scale; width: parent.width - 24px * Theme.scale; name: "SEMANA"; limit: root.claude-7d; tint: Theme.blue; tip(s) => { root.hover-tip = s; } }

        if root.codex-listed : Rectangle {
            Text {
                x: 12px * Theme.scale;
                y: 478px * Theme.scale;
                text: Theme.lb("CODEX");
                color: Theme.text;
                font-family: Theme.label-font;
                font-weight: 600;
                font-size: Theme.lf(13px * Theme.scale);
                letter-spacing: Theme.scaled-tracking;
            }
            LimitRow { x: 12px * Theme.scale; y: 500px * Theme.scale; width: root.width - 24px * Theme.scale; name: "5H"; limit: root.codex-5h; tint: Theme.teal; tip(s) => { root.hover-tip = s; } }
            LimitRow { x: 12px * Theme.scale; y: 522px * Theme.scale; width: root.width - 24px * Theme.scale; name: "SEMANA"; limit: root.codex-7d; tint: Theme.blue; tip(s) => { root.hover-tip = s; } }
        }

        if root.gemini-listed : Rectangle {
            Text {
                x: 12px * Theme.scale;
                y: root.gemini-y;
                text: Theme.lb("GEMINI");
                color: Theme.text;
                font-family: Theme.label-font;
                font-weight: 600;
                font-size: Theme.lf(13px * Theme.scale);
                letter-spacing: Theme.scaled-tracking;
            }
            LimitRow { x: 12px * Theme.scale; y: root.gemini-y + 22px * Theme.scale; width: root.width - 24px * Theme.scale; name: "DIA"; limit: root.gemini-day; tint: Theme.purple; tip(s) => { root.hover-tip = s; } }
        }

        if root.cursor-listed : Rectangle {
            Text {
                x: 12px * Theme.scale;
                y: root.cursor-y;
                text: Theme.lb("CURSOR");
                color: Theme.text;
                font-family: Theme.label-font;
                font-weight: 600;
                font-size: Theme.lf(13px * Theme.scale);
                letter-spacing: Theme.scaled-tracking;
            }
            LimitRow { x: 12px * Theme.scale; y: root.cursor-y + 22px * Theme.scale; width: root.width - 24px * Theme.scale; name: "MÊS"; limit: root.cursor-month; tint: Theme.blue; tip(s) => { root.hover-tip = s; } }
        }

        // OUTROS: one PresenceRow per tool, each at its own y with explicit geometry.
        Label { visible: root.presence.length > 0; x: 12px * Theme.scale; y: root.others-y; text: Theme.lb("OUTROS"); }
        for row[i] in root.presence : PresenceRow {
            x: 12px * Theme.scale;
            y: root.others-y + 18px * Theme.scale + 20px * Theme.scale * i;
            width: 296px * Theme.scale;
            height: 20px * Theme.scale;
            name: row.name;
            status: row.status;
        }

        // Reason for an unavailable value, shown while it is hovered.
        Rectangle {
            visible: root.hover-tip != "" || root.notice != "";
            x: Theme.scaled-cut;
            y: parent.height - 22px * Theme.scale;
            width: parent.width - 2 * Theme.scaled-cut;
            height: 22px * Theme.scale;
            background: Theme.tip-bar;
            Text {
                x: 12px * Theme.scale;
                width: parent.width - 24px * Theme.scale;
                text: root.hover-tip != "" ? root.hover-tip : root.notice;
                color: Theme.amber;
                font-family: Theme.label-font;
                font-weight: 500;
                font-size: Theme.lf(12px * Theme.scale);
                vertical-alignment: center;
                overflow: elide;
            }
        }

        if Theme.has-scanlines : Image {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            source: Theme.scan-tile;
            horizontal-tiling: repeat;
            vertical-tiling: repeat;
        }

        // Resize handle (12 px, not scaled): dragging it diagonally changes the window scale.
        TouchArea {
            x: parent.width - 12px;
            y: parent.height - 12px;
            width: 12px;
            height: 12px;
            mouse-cursor: MouseCursor.nwse-resize;
            moved => { root.resize(root.width, root.height, self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y); }
            pointer-event(e) => { if e.kind == PointerEventKind.up { root.resize-done(); } }
            Path {
                x: 0px;
                y: 0px;
                width: 12px;
                height: 12px;
                viewbox-width: 12;
                viewbox-height: 12;
                commands: "M 11 2 L 2 11 M 11 7 L 7 11";
                stroke: parent.has-hover || parent.pressed ? Theme.title-text : Theme.dim;
                stroke-width: 1px;
            }
        }
    }
}
