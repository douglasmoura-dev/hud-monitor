import { Bar, Field, Limit, PresenceData, Theme } from "theme.slint";
import { MiniBar } from "minibar.slint";
import { CleanRow, Scanner } from "scanner.slint";

export { CleanRow, MiniBar, Scanner, Theme }

component Label inherits Text {
    color: Theme.dim;
    font-family: Theme.label-font;
    font-weight: 600;
    font-size: 11px;
    letter-spacing: 1.5px;
}

component Val inherits Rectangle {
    in property <Field> field;
    in property <length> size: 13px;
    in property <color> tint: Theme.text;
    callback tip(string);
    width: t.preferred-width;
    height: t.preferred-height;
    t := Text {
        text: root.field.text;
        color: root.field.tip == "" ? Theme.tone(root.field.level, root.tint) : Theme.dim;
        font-family: Theme.number-font;
        font-size: root.size;
    }
    TouchArea {
        enabled: root.field.tip != "";
        changed has-hover => { root.tip(self.has-hover ? root.field.tip : ""); }
    }
}

component Meter inherits Rectangle {
    in property <float> percent;
    in property <color> tint;
    height: 6px;
    border-radius: 3px;
    background: Theme.track;
    Rectangle {
        x: 0px;
        width: parent.width * clamp(root.percent, 0, 100) / 100;
        border-radius: 3px;
        background: root.tint;
    }
}

component Rule inherits Rectangle {
    height: 1px;
    background: Theme.track;
}

component Arrow inherits Path {
    in property <bool> down;
    width: 8px;
    height: 7px;
    commands: root.down ? "M 0 0 L 8 0 L 4 7 Z" : "M 0 7 L 8 7 L 4 0 Z";
}

component LimitRow inherits Rectangle {
    in property <string> name;
    in property <Limit> limit;
    in property <color> tint;
    callback tip(string);
    height: 18px;
    Text {
        x: 0px;
        width: 52px;
        text: root.name;
        color: Theme.dim;
        font-family: Theme.label-font;
        font-weight: 600;
        font-size: 11px;
        letter-spacing: 1.5px;
        vertical-alignment: center;
    }
    Meter { x: 56px; y: 6px; width: 100px; percent: root.limit.percent; tint: root.tint; }
    Val { x: 164px; y: 1px; size: 12px; field: root.limit.pct; tip(s) => { root.tip(s); } }
    Text {
        x: parent.width - self.width;
        width: 48px;
        text: root.limit.reset;
        color: Theme.dim;
        font-family: Theme.number-font;
        font-size: 11px;
        vertical-alignment: center;
        horizontal-alignment: right;
    }
}

component GpuCell inherits Rectangle {
    in property <string> name;
    in property <Field> field;
    callback tip(string);
    width: 96px;
    height: 32px;
    Label { x: 0px; y: 0px; text: root.name; }
    Val { x: 0px; y: 14px; field: root.field; tip(s) => { root.tip(s); } }
}

export component Hud inherits Window {
    no-frame: true;
    always-on-top: true;
    background: transparent;
    width: 320px;
    private property <length> gemini-y: 478px + (root.codex-listed ? 66px : 0px);
    private property <length> cursor-y: root.gemini-y + (root.gemini-listed ? 44px : 0px);
    private property <length> others-y: root.cursor-y + (root.cursor-listed ? 44px : 0px);
    private property <length> others-h: root.presence.length > 0 ? 18px + 20px * root.presence.length : 0px;
    height: root.others-y + root.others-h + 22px;
    callback moved(length, length);
    callback released();
    callback quit();
    callback minimize();
    callback pin();
    in property <bool> pinned;
    in property <string> notice;
    in property <float> bg-alpha: 0.88;
    in property <string> clock: "--:--";
    in property <Field> cpu-total;
    in property <Field> cpu-freq;
    in property <Field> cpu-temp;
    in property <Field> cpu-cores;
    in property <[Bar]> core-bars;
    in property <Field> ram;
    in property <float> ram-percent;
    in property <Field> ram-top;
    in property <Field> gpu-intel;
    in property <Field> gpu-nvidia;
    in property <Field> gpu-vram;
    in property <Field> disk;
    in property <float> disk-percent;
    in property <Field> disk-io;
    in property <Field> net-down;
    in property <Field> net-up;
    in property <Field> net-today;
    in property <Field> ping;
    in property <string> claude-plan;
    in property <Limit> claude-5h;
    in property <Limit> claude-7d;
    in property <bool> codex-listed;
    in property <Limit> codex-5h;
    in property <Limit> codex-7d;
    in property <bool> gemini-listed;
    in property <Limit> gemini-day;
    in property <bool> cursor-listed;
    in property <Limit> cursor-month;
    in property <[PresenceData]> presence;
    property <string> hover-tip;

    Rectangle {
        background: Theme.background.with-alpha(root.bg-alpha);
        border-color: Theme.border;
        border-width: 1px;
        border-radius: Theme.radius;
        clip: true;

        // Title bar
        Rectangle {
            y: 0px;
            height: 30px;
            background: Theme.title-bar;
            TouchArea {
                moved => { root.moved(self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y); }
                pointer-event(e) => { if e.kind == PointerEventKind.up { root.released(); } }
            }
            for row in [0, 1, 2]: Rectangle {
                x: 10px;
                y: 9px + row * 5px;
                width: 8px;
                height: 2px;
                background: Theme.dim;
            }
            Text {
                x: 26px;
                text: "SYS // MONITOR";
                color: Theme.teal;
                font-family: Theme.label-font;
                font-weight: 600;
                font-size: 14px;
                letter-spacing: 1.5px;
                vertical-alignment: center;
            }
            Text {
                x: parent.width - 138px;
                width: 48px;
                text: root.clock;
                color: Theme.dim;
                font-family: Theme.number-font;
                font-size: 12px;
                vertical-alignment: center;
                horizontal-alignment: right;
            }
            TouchArea { // pin: toggles click-through (hold Ctrl to interact meanwhile)
                x: parent.width - 86px;
                width: 22px;
                clicked => { root.pin(); }
                Rectangle {
                    x: 6px;
                    y: 10px;
                    width: 10px;
                    height: 10px;
                    border-radius: 5px;
                    border-width: 1.5px;
                    border-color: root.pinned || parent.has-hover ? Theme.teal : Theme.dim;
                    background: root.pinned ? Theme.teal : transparent;
                }
            }
            TouchArea { // minimize to the mini bar
                x: parent.width - 62px;
                width: 22px;
                clicked => { root.minimize(); }
                Rectangle {
                    x: 6px;
                    y: 10px;
                    width: 10px;
                    height: 10px;
                    border-width: 1.5px;
                    border-color: Theme.dim;
                }
            }
            TouchArea { // close
                x: parent.width - 32px;
                width: 28px;
                clicked => { root.quit(); }
                Path {
                    x: 9px;
                    y: 10px;
                    width: 10px;
                    height: 10px;
                    commands: "M 0 0 L 10 10 M 10 0 L 0 10";
                    stroke: Theme.dim;
                    stroke-width: 1.5px;
                }
            }
        }

        // CPU
        Label { x: 12px; y: 36px; text: "CPU"; }
        Val { x: 12px; y: 48px; size: 28px; tint: Theme.teal; field: root.cpu-total; tip(s) => { root.hover-tip = s; } }
        Val { x: 100px; y: 52px; field: root.cpu-freq; tip(s) => { root.hover-tip = s; } }
        Val { x: 100px; y: 70px; field: root.cpu-temp; tip(s) => { root.hover-tip = s; } }
        Val { x: 12px; y: 88px; size: 11px; tint: Theme.dim; field: root.cpu-cores; tip(s) => { root.hover-tip = s; } }
        for bar[i] in root.core-bars: Rectangle {
            x: 12px + i * 18px;
            y: 106px;
            width: 14px;
            height: 28px;
            background: Theme.track;
            Rectangle {
                y: parent.height * (1 - clamp(bar.percent, 0, 100) / 100);
                height: parent.height - self.y;
                background: bar.hot ? Theme.crit : Theme.green;
            }
        }
        Rule { x: 12px; y: 142px; width: parent.width - 24px; }

        // RAM
        Label { x: 12px; y: 148px; text: "RAM"; }
        Val { x: parent.width - 12px - self.width; y: 146px; field: root.ram; tip(s) => { root.hover-tip = s; } }
        Meter { x: 12px; y: 168px; width: parent.width - 24px; percent: root.ram-percent; tint: Theme.purple; }
        Val { x: 12px; y: 178px; size: 10px; tint: Theme.dim; field: root.ram-top; tip(s) => { root.hover-tip = s; } }
        Rule { x: 12px; y: 200px; width: parent.width - 24px; }

        // GPU
        Label { x: 12px; y: 206px; text: "GPU"; }
        GpuCell { x: 12px; y: 222px; name: "INTEL"; field: root.gpu-intel; tip(s) => { root.hover-tip = s; } }
        GpuCell { x: 112px; y: 222px; name: "NVIDIA"; field: root.gpu-nvidia; tip(s) => { root.hover-tip = s; } }
        GpuCell { x: 212px; y: 222px; name: "VRAM"; field: root.gpu-vram; tip(s) => { root.hover-tip = s; } }
        Rule { x: 12px; y: 262px; width: parent.width - 24px; }

        // DISCO
        Label { x: 12px; y: 268px; text: "DISCO"; }
        Val { x: parent.width - 12px - self.width; y: 266px; field: root.disk; tip(s) => { root.hover-tip = s; } }
        Meter { x: 12px; y: 288px; width: parent.width - 24px; percent: root.disk-percent; tint: Theme.amber; }
        Val { x: 12px; y: 298px; size: 11px; tint: Theme.dim; field: root.disk-io; tip(s) => { root.hover-tip = s; } }
        Rule { x: 12px; y: 318px; width: parent.width - 24px; }

        // REDE
        Label { x: 12px; y: 324px; text: "REDE"; }
        Arrow { x: 12px; y: 345px; down: true; fill: Theme.teal; }
        Val { x: 26px; y: 340px; tint: Theme.teal; field: root.net-down; tip(s) => { root.hover-tip = s; } }
        Arrow { x: 160px; y: 345px; down: false; fill: Theme.blue; }
        Val { x: 174px; y: 340px; tint: Theme.blue; field: root.net-up; tip(s) => { root.hover-tip = s; } }
        Val { x: 12px; y: 362px; size: 11px; tint: Theme.dim; field: root.net-today; tip(s) => { root.hover-tip = s; } }
        Val { x: 160px; y: 362px; size: 11px; tint: Theme.dim; field: root.ping; tip(s) => { root.hover-tip = s; } }

        Rule { x: 12px; y: 384px; width: parent.width - 24px; }

        // LIMITES IA
        Label { x: 12px; y: 390px; text: "LIMITES IA"; }
        Text {
            x: 12px;
            y: 408px;
            text: "CLAUDE";
            color: Theme.text;
            font-family: Theme.label-font;
            font-weight: 600;
            font-size: 13px;
            letter-spacing: 1px;
        }
        Rectangle {
            visible: root.claude-plan != "";
            x: 70px;
            y: 409px;
            width: badge.preferred-width + 10px;
            height: 15px;
            border-radius: 3px;
            border-width: 1px;
            border-color: Theme.teal;
            badge := Text {
                x: 5px;
                text: root.claude-plan;
                color: Theme.teal;
                font-family: Theme.label-font;
                font-weight: 600;
                font-size: 10px;
                letter-spacing: 1px;
                vertical-alignment: center;
            }
        }
        LimitRow { x: 12px; y: 430px; width: parent.width - 24px; name: "5H"; limit: root.claude-5h; tint: Theme.teal; tip(s) => { root.hover-tip = s; } }
        LimitRow { x: 12px; y: 452px; width: parent.width - 24px; name: "SEMANA"; limit: root.claude-7d; tint: Theme.blue; tip(s) => { root.hover-tip = s; } }

        if root.codex-listed : Rectangle {
            Text {
                x: 12px;
                y: 478px;
                text: "CODEX";
                color: Theme.text;
                font-family: Theme.label-font;
                font-weight: 600;
                font-size: 13px;
                letter-spacing: 1px;
            }
            LimitRow { x: 12px; y: 500px; width: root.width - 24px; name: "5H"; limit: root.codex-5h; tint: Theme.teal; tip(s) => { root.hover-tip = s; } }
            LimitRow { x: 12px; y: 522px; width: root.width - 24px; name: "SEMANA"; limit: root.codex-7d; tint: Theme.blue; tip(s) => { root.hover-tip = s; } }
        }

        if root.gemini-listed : Rectangle {
            Text {
                x: 12px;
                y: root.gemini-y;
                text: "GEMINI";
                color: Theme.text;
                font-family: Theme.label-font;
                font-weight: 600;
                font-size: 13px;
                letter-spacing: 1px;
            }
            LimitRow { x: 12px; y: root.gemini-y + 22px; width: root.width - 24px; name: "DIA"; limit: root.gemini-day; tint: Theme.purple; tip(s) => { root.hover-tip = s; } }
        }

        if root.cursor-listed : Rectangle {
            Text {
                x: 12px;
                y: root.cursor-y;
                text: "CURSOR";
                color: Theme.text;
                font-family: Theme.label-font;
                font-weight: 600;
                font-size: 13px;
                letter-spacing: 1px;
            }
            LimitRow { x: 12px; y: root.cursor-y + 22px; width: root.width - 24px; name: "MÊS"; limit: root.cursor-month; tint: Theme.blue; tip(s) => { root.hover-tip = s; } }
        }

        if root.presence.length > 0 : Rectangle {
            Label { x: 12px; y: root.others-y; text: "OUTROS"; }
            for row[i] in root.presence : Rectangle {
                x: 12px;
                y: root.others-y + 18px + 20px * i;
                width: root.width - 24px;
                height: 20px;
                Text {
                    width: 90px;
                    text: row.name;
                    color: Theme.dim;
                    font-family: Theme.label-font;
                    font-weight: 600;
                    font-size: 11px;
                    letter-spacing: 1.5px;
                    vertical-alignment: center;
                }
                Text {
                    x: 100px;
                    text: row.status;
                    color: row.status == "inativo" ? Theme.dim : Theme.teal;
                    font-family: Theme.number-font;
                    font-size: 12px;
                    vertical-alignment: center;
                }
            }
        }

        // Reason for an unavailable value, shown while it is hovered.
        Rectangle {
            visible: root.hover-tip != "" || root.notice != "";
            y: parent.height - 22px;
            height: 22px;
            background: Theme.tip-bar;
            Text {
                x: 12px;
                width: parent.width - 24px;
                text: root.hover-tip != "" ? root.hover-tip : root.notice;
                color: Theme.amber;
                font-family: Theme.label-font;
                font-weight: 500;
                font-size: 12px;
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }
}
